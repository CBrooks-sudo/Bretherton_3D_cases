FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../simSetup"

defaultFieldValues
(
    volScalarFieldValue alpha.bubble 0
);

regions
(
    sphereToCell
    {
        centre (#calc "$R*$xb0ToR" 0 0);
	radius #calc "$R*$RbToR";
	
        fieldValues
        (
            volScalarFieldValue alpha.bubble 1
        );
    }
    
    sphereToCell
    {
        centre (#calc "$R*($xb0ToR+$LbToR)" 0 0);
	radius #calc "$R*$RbToR";
	
        fieldValues
        (
            volScalarFieldValue alpha.bubble 1
        );
    }
  
    cylinderToCell
    {
        p1 (#calc "$R*$xb0ToR" 0 0);
        p2 (#calc "$R*($xb0ToR+$LbToR)" 0 0);
	radius #calc "$R*$RbToR";
        fieldValues
        (
            volScalarFieldValue alpha.bubble 1
        );
    }
  
);


