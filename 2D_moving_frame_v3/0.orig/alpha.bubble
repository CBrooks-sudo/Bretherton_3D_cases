boundaryField
{
    outlet
    {
        // moving frame: liquid near the wall flows back in through the outlet, so supply liquid there
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }
    upper_wall
    {
        type           constantAlphaContactAngle;
        theta0         0;
        limit          gradient;
        value          uniform 0;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    lower_wall
    {
        type            empty;
    }
}



