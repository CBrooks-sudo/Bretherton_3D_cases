#!/bin/sh
cd "${0%/*}" || exit 1    # Run from this directory
#------------------------------------------------------------------------------
# Removes everything Allrun creates. The case set-up is kept:
# 0.orig/, constant/ (except the mesh), system/, simSetup and the scripts.
#------------------------------------------------------------------------------

rm -rf 0                  # working copy of the initial fields (restored from 0.orig)
rm -rf constant/polyMesh
rm -rf processor*
rm -rf dynamicCode
rm -rf postProcessing
rm -f  bubbleInfo
rm -f  log.*

# Time directories written by the solver (e.g. 0.5, 1, 1.5 ...)
for d in [0-9]*
do
    if [ -d "$d" ] && [ "$d" != "0.orig" ]
    then
        rm -rf "$d"
    fi
done

#------------------------------------------------------------------------------
